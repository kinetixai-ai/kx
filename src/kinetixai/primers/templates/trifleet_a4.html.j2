<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ primer.title }}</title>
<style>
/* ── TriFleetRCA / TriParseGPU A4 print spec ─────────────────────────── */
:root {
  --ink: #16181d; --muted: #5b6372; --line: #e3e6ec;
  --accent: #d2232a;          /* KinetixAI Swiss red */
  --accent-2: #1d4ed8; --accent-3: #047857; --accent-4: #b45309;
  --paper: #ffffff; --wash: #f6f7f9; --code-bg: #101418; --code-ink: #d6e2f0;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
@page { size: A4; margin: 0; }
html, body { background: #9aa0ab; }
body { font-family: Inter, "Liberation Sans", system-ui, -apple-system, Arial, sans-serif;
       font-size: 10.25pt; line-height: 1.42; color: var(--ink); }

section.page {
  width: 210mm; height: 297mm; padding: 10mm 12mm;
  box-sizing: border-box; page-break-after: always; position: relative;
  overflow: hidden; background: var(--paper); margin: 0 auto;
  display: flex; flex-direction: column;
}
@media screen { section.page { margin: 8mm auto; box-shadow: 0 2mm 6mm rgba(0,0,0,.25); } }

/* running header */
.hd { display: flex; align-items: flex-start; justify-content: space-between;
      border-bottom: 1.2mm solid var(--ink); padding-bottom: 2.5mm; margin-bottom: 4mm; }
.hd .t { max-width: 140mm; }
.hd h1 { font-size: 15pt; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
.hd .sub { display: inline-block; margin-top: 1.2mm; background: var(--ink); color: #fff;
           font-size: 7.5pt; font-weight: 700; padding: .8mm 2.5mm; text-transform: uppercase;
           letter-spacing: .08em; }
.hd .badge { text-align: right; font-size: 7pt; color: var(--muted); line-height: 1.35; }
.hd .badge b { display: block; color: var(--ink); font-size: 8pt; }
.hd .badge .pg { display: inline-block; margin-top: 1mm; border: .4mm solid var(--ink);
                 font-weight: 800; font-size: 8pt; padding: .5mm 2mm; color: var(--ink); }

/* content area */
main { flex: 1 1 auto; overflow: hidden; }

/* numbered section headers with colored pill badges */
.sec { margin: 0 0 3mm; }
.sec .pill-row { display: flex; align-items: baseline; gap: 2.5mm; margin-bottom: 1.2mm; }
.sec .pill { flex: 0 0 auto; background: var(--accent); color: #fff; font-weight: 800;
             font-size: 9pt; width: 6.5mm; height: 6.5mm; border-radius: 1.2mm;
             display: inline-flex; align-items: center; justify-content: center; }
.sec:nth-of-type(4n+2) .pill { background: var(--accent-2); }
.sec:nth-of-type(4n+3) .pill { background: var(--accent-3); }
.sec:nth-of-type(4n)   .pill { background: var(--accent-4); }
.sec h2 { font-size: 11pt; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
.sec p { text-align: justify; hyphens: auto; }

/* bento grids */
.bento { display: grid; gap: 2.5mm; margin: 0 0 3mm; }
.bento.c2 { grid-template-columns: 1fr 1fr; }
.bento.c3 { grid-template-columns: 1fr 1fr 1fr; }
.card { background: var(--wash); border: .3mm solid var(--line); border-top: 1mm solid var(--accent);
        border-radius: 1.5mm; padding: 2.5mm 3mm; }
.card:nth-child(4n+2) { border-top-color: var(--accent-2); }
.card:nth-child(4n+3) { border-top-color: var(--accent-3); }
.card:nth-child(4n)   { border-top-color: var(--accent-4); }
.card h3 { font-size: 9pt; font-weight: 800; margin-bottom: 1mm; }
.card p { font-size: 8.8pt; color: #2a2f38; }

/* tables */
table.cmp { width: 100%; border-collapse: collapse; margin: 0 0 3mm; font-size: 8.6pt; }
.cmp caption { caption-side: top; text-align: left; font-weight: 800; font-size: 9.5pt;
               margin-bottom: 1.2mm; text-transform: uppercase; }
.cmp th { background: var(--ink); color: #fff; text-align: left; padding: 1.4mm 2mm;
          font-size: 8pt; text-transform: uppercase; letter-spacing: .04em; }
.cmp td { border: .3mm solid var(--line); padding: 1.3mm 2mm; vertical-align: top; }
.cmp tr:nth-child(even) td { background: var(--wash); }

/* SVG flow */
.flow { margin: 0 0 3mm; }
.flow h4 { font-size: 9.5pt; font-weight: 800; text-transform: uppercase; margin-bottom: 1.2mm; }

/* terminal code boxes */
.code { background: var(--code-bg); color: var(--code-ink); border-radius: 1.5mm;
        padding: 2.5mm 3mm; margin: 0 0 3mm; font-family: "JetBrains Mono", "Liberation Mono",
        Consolas, monospace; font-size: 8pt; line-height: 1.5; white-space: pre-wrap; }
.code .bar { color: #8b96a5; font-family: inherit; font-size: 7.2pt; text-transform: uppercase;
             letter-spacing: .08em; display: block; margin-bottom: 1.2mm; }
.code .dot { display: inline-block; width: 2mm; height: 2mm; border-radius: 50%;
             margin-right: 1mm; vertical-align: middle; }

/* callouts */
.callout { border-left: 1.6mm solid var(--accent); background: var(--wash);
           padding: 2.2mm 3mm; margin: 0 0 3mm; border-radius: 0 1.5mm 1.5mm 0; }
.callout h5 { font-size: 8.6pt; font-weight: 800; text-transform: uppercase; margin-bottom: .8mm; }
.callout p { font-size: 8.8pt; }
.callout.trap      { border-color: var(--accent-4); }
.callout.security  { border-color: var(--accent); }
.callout.tip       { border-color: var(--accent-2); }
.callout.mnemonic  { border-color: var(--accent-3); }
.callout.benchmark { border-color: var(--accent-2); }
.callout.misreading{ border-color: var(--accent-4); }

/* kv */
.kv { margin: 0 0 3mm; }
.kv h4 { font-size: 9.5pt; font-weight: 800; text-transform: uppercase; margin-bottom: 1.2mm; }
.kv dl { display: grid; grid-template-columns: auto 1fr; gap: .8mm 3mm; font-size: 8.8pt; }
.kv dt { font-weight: 700; }
.kv dd { color: #2a2f38; }

/* starburst */
.burst { position: relative; display: inline-block; margin: 1mm 0 3mm; }
.burst span { display: inline-block; background: var(--accent); color: #fff; font-weight: 900;
              font-size: 9.5pt; padding: 2mm 5mm; transform: rotate(-2deg);
              clip-path: polygon(2% 10%, 8% 0, 15% 9%, 25% 2%, 32% 10%, 43% 1%, 50% 10%, 60% 2%,
                 68% 10%, 78% 2%, 85% 10%, 94% 3%, 98% 12%, 100% 50%, 97% 88%, 92% 98%, 82% 91%,
                 72% 99%, 62% 90%, 52% 99%, 42% 90%, 32% 99%, 22% 91%, 12% 99%, 5% 90%, 0 55%); }

/* running footer */
.ft { flex: 0 0 auto; margin-top: 3mm; }
.ft .takeaway { background: var(--ink); color: #fff; border-radius: 1.5mm;
                padding: 2.2mm 3.5mm; font-size: 9pt; display: flex; gap: 2.5mm; align-items: baseline; }
.ft .takeaway b { color: #fff; background: var(--accent); font-size: 7pt; padding: .6mm 2mm;
                  border-radius: 1mm; text-transform: uppercase; letter-spacing: .06em; flex: 0 0 auto; }
.ft .wm { display: flex; justify-content: space-between; align-items: center;
          margin-top: 2mm; font-size: 7pt; color: var(--muted); }
.ft .wm .motiv { font-weight: 800; color: var(--accent); text-transform: uppercase;
                 letter-spacing: .04em; }
</style>
</head>
<body>
{% for page in primer.pages %}
<section class="page"{% if editable %} contenteditable="true"{% endif %}>
  <header class="hd">
    <div class="t">
      <h1>{{ page.title or primer.title }}</h1>
      <span class="sub">{{ page.subtitle or primer.subtitle or primer.topic }}</span>
    </div>
    <div class="badge">
      <b>{{ primer.author }}</b>
      Narmadya Innovations
      <br><span class="pg">{{ loop.index }}/{{ primer.pages|length }}</span>
    </div>
  </header>
  <main>
  {% for b in page.blocks %}
    {% if b.type == 'section' %}
    <div class="sec">
      <div class="pill-row"><span class="pill">{{ b.num or loop.index }}</span><h2>{{ b.title }}</h2></div>
      <p>{{ b.body }}</p>
    </div>
    {% elif b.type == 'bento' %}
    <div class="bento c{{ b.columns if b.columns in (2, 3) else 3 }}">
      {% for c in b.cards %}<div class="card"><h3>{{ c.title }}</h3><p>{{ c.body }}</p></div>{% endfor %}
    </div>
    {% elif b.type == 'table' %}
    <table class="cmp">{% if b.title %}<caption>{{ b.title }}</caption>{% endif %}
      <thead><tr>{% for h in b.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>{% for r in b.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    {% elif b.type == 'flow' %}
    <div class="flow">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      {% set n = b.steps|length %}
      {% set bw = (186 - (n - 1) * 6) / n %}
      <svg viewBox="0 0 186 16" width="100%" xmlns="http://www.w3.org/2000/svg" role="img"
           aria-label="{{ b.title or 'flow' }}">
        {% for s in b.steps %}
        {% set x = loop.index0 * (bw + 6) %}
        <rect x="{{ '%.1f' % x }}" y="1" width="{{ '%.1f' % bw }}" height="14" rx="2"
              fill="{{ ['#d2232a','#1d4ed8','#047857','#b45309'][loop.index0 % 4] }}"/>
        {% set fs = [4.2, (bw - 2) / (0.62 * s|length)]|min %}
        <text x="{{ '%.1f' % (x + bw / 2) }}" y="10" text-anchor="middle" fill="#fff"
              font-family="Inter, Arial, sans-serif" font-size="{{ '%.1f' % fs }}"
              font-weight="700">{{ s }}</text>
        {% if not loop.last %}
        <path d="M {{ '%.1f' % (x + bw + 0.8) }} 8 l 4.4 0 m -1.8 -1.8 l 1.8 1.8 l -1.8 1.8"
              stroke="#16181d" stroke-width="1" fill="none"/>
        {% endif %}
        {% endfor %}
      </svg>
    </div>
    {% elif b.type == 'code' %}
    <div class="code"><span class="bar"><span class="dot" style="background:#ff5f57"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span> {{ b.title or b.lang or 'terminal' }}</span>{{ b.code }}</div>
    {% elif b.type == 'callout' %}
    <div class="callout {{ b.style }}"><h5>{{ b.title }}</h5><p>{{ b.body }}</p></div>
    {% elif b.type == 'kv' %}
    <div class="kv">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      <dl>{% for k, v in b.pairs %}<dt>{{ k }}</dt><dd>{{ v }}</dd>{% endfor %}</dl>
    </div>
    {% elif b.type == 'starburst' %}
    <div class="burst"><span>{{ b.text }}</span></div>
    {% endif %}
  {% endfor %}
  </main>
  <footer class="ft">
    {% if page.takeaway %}
    <div class="takeaway"><b>Key takeaway</b><span>{{ page.takeaway }}</span></div>
    {% endif %}
    <div class="wm">
      <span>{{ primer.watermark }}</span>
      <span class="motiv">{{ primer.badge }}</span>
    </div>
  </footer>
</section>
{% endfor %}
{% if primer.citations %}
<section class="page">
  <header class="hd">
    <div class="t"><h1>References</h1><span class="sub">Verified sources</span></div>
    <div class="badge"><b>{{ primer.author }}</b>Narmadya Innovations
      <br><span class="pg">{{ primer.pages|length + 1 }}/{{ primer.pages|length + 1 }}</span></div>
  </header>
  <main>
    <table class="cmp"><caption>Works cited (metadata verified via arXiv / Semantic Scholar / OpenAlex)</caption>
      <thead><tr><th>#</th><th>Work</th><th>Authors</th><th>Year</th><th>ID</th></tr></thead>
      <tbody>
      {% for c in primer.citations %}
      <tr><td>{{ loop.index }}</td><td>{{ c.title }}</td>
          <td>{{ (c.authors or [])[:3]|join(', ') }}{% if (c.authors or [])|length > 3 %} et al.{% endif %}</td>
          <td>{{ c.year or '' }}</td><td>{{ c.arxiv_id or c.doi or '' }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </main>
  <footer class="ft">
    <div class="wm"><span>{{ primer.watermark }}</span><span class="motiv">{{ primer.badge }}</span></div>
  </footer>
</section>
{% endif %}
</body>
</html>
