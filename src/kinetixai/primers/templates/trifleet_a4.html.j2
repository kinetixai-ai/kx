<!DOCTYPE html>
<html lang="en">
{# total includes the references page, so every badge reads n/TOTAL #}
{% set total = primer.pages|length + (1 if primer.citations else 0) %}
{% set bar_colors = ['#f472b6', '#38bdf8', '#facc15', '#c084fc', '#4ade80'] %}
<head>
<meta charset="utf-8">
<title>{{ primer.title }}</title>
<style>
/* ── TriFleetRCA / TriParseGPU A4 print spec ─────────────────────────── */
:root {
  --ink: #16181d; --muted: #5b6372; --line: #e3e6ec;
  --accent: #d2232a;          /* KinetixAI Swiss red */
  --accent-2: #1d4ed8; --accent-3: #047857; --accent-4: #b45309;
  --paper: #ffffff; --wash: #f6f7f9; --code-bg: #101418; --code-ink: #d6e2f0;
  --cloud-bg: #fce7f3; --cloud-ink: #db2777;
  --pastel-1: #fdf2f8; --pastel-2: #eff6ff; --pastel-3: #ecfdf5; --pastel-4: #fffbeb;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
@page { size: A4; margin: 0; }
html, body { background: #9aa0ab; }
body { font-family: Inter, "Liberation Sans", system-ui, -apple-system, Arial, sans-serif;
       font-size: 10.25pt; line-height: 1.42; color: var(--ink); }

section.page {
  width: 210mm; height: 297mm; padding: 10mm 12mm 28mm;
  box-sizing: border-box; page-break-after: always; position: relative;
  overflow: hidden; background: var(--paper); margin: 0 auto;
}
@media screen { section.page { margin: 8mm auto; box-shadow: 0 2mm 6mm rgba(0,0,0,.25); } }

/* running header */
.hd { display: flex; align-items: flex-start; justify-content: space-between;
      border-bottom: 1.2mm solid var(--ink); padding-bottom: 2.5mm; margin-bottom: 3.5mm;
      height: 26mm; overflow: hidden; }
.hd .t { max-width: 136mm; }
.hd h1 { font-size: 14.5pt; font-weight: 800; text-transform: uppercase; letter-spacing: .01em;
         line-height: 1.16; }
.hd .sub { display: inline-block; margin-top: 1.2mm; background: var(--ink); color: #fff;
           font-size: 7.5pt; font-weight: 700; padding: .8mm 2.5mm; text-transform: uppercase;
           letter-spacing: .08em; }
.hd .badge { text-align: right; font-size: 7pt; color: var(--muted); line-height: 1.35;
             flex: 0 0 auto; }
.hd .badge b { display: block; color: var(--ink); font-size: 8pt; }
.hd .badge .pg { display: inline-block; margin-top: 1mm; border: .4mm solid var(--ink);
                 font-weight: 800; font-size: 8pt; padding: .5mm 2mm; color: var(--ink); }
/* tilted hand-drawn house mark, top-left and bottom-left */
.mark { font-weight: 800; font-size: 7pt; letter-spacing: .04em; color: var(--accent);
        text-transform: uppercase; transform: rotate(-2.2deg); display: inline-block;
        border-bottom: .5mm solid var(--accent); padding-bottom: .3mm; margin-bottom: 1.4mm; }

/* content area */
main { height: 222mm; overflow: hidden; }

/* numbered section headers with colored pill badges */
.sec { margin: 0 0 2.1mm; }
.sec .pill-row { display: flex; align-items: baseline; gap: 2.5mm; margin-bottom: 1mm; }
.sec .pill { flex: 0 0 auto; background: var(--accent); color: #fff; font-weight: 800;
             font-size: 9pt; width: 6.2mm; height: 6.2mm; border-radius: 1.2mm;
             display: inline-flex; align-items: center; justify-content: center; }
.sec:nth-of-type(4n+2) .pill { background: var(--accent-2); }
.sec:nth-of-type(4n+3) .pill { background: var(--accent-3); }
.sec:nth-of-type(4n)   .pill { background: var(--accent-4); }
.sec h2 { font-size: 10.5pt; font-weight: 800; text-transform: uppercase; letter-spacing: .01em; }
.sec p { text-align: justify; hyphens: auto; }

/* bento grids — pastel cards */
.bento { display: grid; gap: 2.2mm; margin: 0 0 2.1mm; }
.bento.c2 { grid-template-columns: 1fr 1fr; }
.bento.c3 { grid-template-columns: 1fr 1fr 1fr; }
.bento.c4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
.card { background: var(--pastel-1); border: .3mm solid var(--line); border-top: 1mm solid var(--accent);
        border-radius: 1.5mm; padding: 2.2mm 2.6mm; }
.card:nth-child(4n+2) { border-top-color: var(--accent-2); background: var(--pastel-2); }
.card:nth-child(4n+3) { border-top-color: var(--accent-3); background: var(--pastel-3); }
.card:nth-child(4n)   { border-top-color: var(--accent-4); background: var(--pastel-4); }
.card h3 { font-size: 8.8pt; font-weight: 800; margin-bottom: .8mm; }
.card p { font-size: 8.4pt; color: #2a2f38; }

/* tables */
table.cmp { width: 100%; border-collapse: collapse; margin: 0 0 2.1mm; font-size: 8.4pt; }
.cmp caption { caption-side: top; text-align: left; font-weight: 800; font-size: 9.5pt;
               margin-bottom: 1.2mm; text-transform: uppercase; }
.cmp th { background: var(--ink); color: #fff; text-align: left; padding: 1.3mm 2mm;
          font-size: 7.8pt; text-transform: uppercase; letter-spacing: .04em; }
.cmp td { border: .3mm solid var(--line); padding: 1.2mm 2mm; vertical-align: top; }
.cmp tr:nth-child(even) td { background: var(--wash); }

/* SVG flow / charts / hierarchy */
.flow, .chart, .hier, .steps { margin: 0 0 2.1mm; }
.flow h4, .chart h4, .hier h4, .steps h4 { font-size: 9.2pt; font-weight: 800;
       text-transform: uppercase; margin-bottom: 1.2mm; }
.chart .note { font-size: 7.4pt; color: var(--muted); margin-top: .6mm; }

/* numbered steps, top to bottom */
.steps ol { list-style: none; counter-reset: s; }
.steps li { counter-increment: s; position: relative; padding-left: 7.5mm;
            margin-bottom: 1.3mm; font-size: 8.8pt; }
.steps li::before { content: counter(s); position: absolute; left: 0; top: -0.2mm;
            width: 5.4mm; height: 5.4mm; border-radius: 1.2mm; background: var(--accent-2);
            color: #fff; font-weight: 800; font-size: 8pt; display: flex;
            align-items: center; justify-content: center; }
.steps li:nth-child(4n+2)::before { background: var(--accent-3); }
.steps li:nth-child(4n+3)::before { background: var(--accent-4); }
.steps li:nth-child(4n)::before   { background: var(--accent); }

/* terminal code boxes */
.code { background: var(--code-bg); color: var(--code-ink); border-radius: 1.5mm;
        padding: 2.2mm 2.8mm; margin: 0 0 2.1mm; font-family: "JetBrains Mono",
        "Liberation Mono", Consolas, monospace; font-size: 7.6pt; line-height: 1.45;
        white-space: pre-wrap; }
.code .bar { color: #8b96a5; font-family: inherit; font-size: 7pt; text-transform: uppercase;
             letter-spacing: .08em; display: block; margin-bottom: 1mm; }
.code .dot { display: inline-block; width: 1.9mm; height: 1.9mm; border-radius: 50%;
             margin-right: .9mm; vertical-align: middle; }

/* callouts */
.callout { border-left: 1.6mm solid var(--accent); background: var(--wash);
           padding: 2mm 2.8mm; margin: 0 0 2.1mm; border-radius: 0 1.5mm 1.5mm 0; }
.callout h5 { font-size: 8.4pt; font-weight: 800; text-transform: uppercase; margin-bottom: .7mm; }
.callout p { font-size: 8.5pt; }
.callout.trap, .callout.misreading, .callout.warning { border-color: var(--accent-4); }
.callout.security  { border-color: var(--accent); }
.callout.tip, .callout.benchmark { border-color: var(--accent-2); }
.callout.mnemonic  { border-color: var(--accent-3); background: #f0fdf4; }

/* kv */
.kv { margin: 0 0 2.1mm; }
.kv h4 { font-size: 9.2pt; font-weight: 800; text-transform: uppercase; margin-bottom: 1.1mm; }
.kv dl { display: grid; grid-template-columns: auto 1fr; gap: .7mm 3mm; font-size: 8.5pt; }
.kv dt { font-weight: 700; }
.kv dd { color: #2a2f38; }

/* comic cloud + starburst */
.cloud { margin: 0 0 2.1mm; }
.burst { position: relative; display: inline-block; margin: 1mm 0 2.6mm; }
.burst span { display: inline-block; background: var(--accent); color: #fff; font-weight: 900;
              font-size: 9.5pt; padding: 2mm 5mm; transform: rotate(-2deg);
              clip-path: polygon(2% 10%, 8% 0, 15% 9%, 25% 2%, 32% 10%, 43% 1%, 50% 10%, 60% 2%,
                 68% 10%, 78% 2%, 85% 10%, 94% 3%, 98% 12%, 100% 50%, 97% 88%, 92% 98%, 82% 91%,
                 72% 99%, 62% 90%, 52% 99%, 42% 90%, 32% 99%, 22% 91%, 12% 99%, 5% 90%, 0 55%); }

/* running footer */
.ft { position: absolute; left: 12mm; right: 12mm; bottom: 9mm; }
.ft .takeaway { background: var(--ink); color: #fff; border-radius: 1.5mm;
                padding: 2mm 3.2mm; font-size: 8.8pt; display: flex; gap: 2.5mm; align-items: baseline; }
.ft .takeaway b { color: #fff; background: var(--accent); font-size: 6.8pt; padding: .5mm 1.8mm;
                  border-radius: 1mm; text-transform: uppercase; letter-spacing: .06em; flex: 0 0 auto; }
.ft .wm { display: flex; justify-content: space-between; align-items: flex-end;
          margin-top: 1.8mm; font-size: 7pt; color: var(--muted); }
.ft .wm .motiv { font-weight: 800; color: var(--accent); text-transform: uppercase;
                 letter-spacing: .04em; transform: rotate(-1.5deg); display: inline-block; }
</style>
</head>
<body>

{# ── reusable comic cloud ───────────────────────────────────────────── #}
{% macro comic_cloud(text) %}
{# scalloped comic cloud: 11 bumps along the top and bottom, built from arcs
   so the outline is one clean closed path rather than overlapping shapes #}
{% set W = 186 %}{% set H = 15 %}{% set N = 15 %}
{% set r = W / (2 * N) %}
<div class="cloud">
  <svg viewBox="0 0 {{ W }} {{ H + 4 }}" width="100%" xmlns="http://www.w3.org/2000/svg"
       role="img" aria-label="{{ text }}">
    <g transform="rotate(-2.4 {{ W / 2 }} {{ (H + 4) / 2 }})">
      {# red radiating action ticks #}
      {% for t in range(N) %}
      {% set x = r + t * 2 * r %}
      <path d="M {{ '%.1f' % x }} 1.6 l {{ '%.1f' % (-1.1 if t % 2 else 1.1) }} -1.5"
            stroke="#d2232a" stroke-width="0.8" stroke-linecap="round"/>
      <path d="M {{ '%.1f' % x }} {{ H + 2.4 }} l {{ '%.1f' % (1.1 if t % 2 else -1.1) }} 1.5"
            stroke="#d2232a" stroke-width="0.8" stroke-linecap="round"/>
      {% endfor %}
      <path d="M 0 {{ '%.2f' % (r + 2) }}
               {% for i in range(N) %}a {{ '%.2f' % r }} {{ '%.2f' % r }} 0 0 1 {{ '%.2f' % (2 * r) }} 0 {% endfor %}
               a {{ '%.2f' % r }} {{ '%.2f' % r }} 0 0 1 0 {{ '%.2f' % (H - 2 * r) }}
               {% for i in range(N) %}a {{ '%.2f' % r }} {{ '%.2f' % r }} 0 0 1 {{ '%.2f' % (-2 * r) }} 0 {% endfor %}
               a {{ '%.2f' % r }} {{ '%.2f' % r }} 0 0 1 0 {{ '%.2f' % (-(H - 2 * r)) }} Z"
            fill="#fce7f3" stroke="#db2777" stroke-width="1" stroke-linejoin="round"/>
      <rect x="{{ '%.1f' % r }}" y="3.4" width="{{ '%.1f' % (W - 2 * r) }}"
            height="{{ '%.1f' % (H - 6.8) }}" fill="#fce7f3"/>
      <text x="{{ W / 2 }}" y="{{ '%.1f' % (H / 2 + 2.9) }}" text-anchor="middle" fill="#9d174d"
            font-family="Inter, Arial, sans-serif" font-size="4.8" font-weight="800">{{ text }}</text>
    </g>
  </svg>
</div>
{% endmacro %}

{% for page in primer.pages %}
<section class="page"{% if editable %} contenteditable="true"{% endif %}>
  <header class="hd">
    <div class="t">
      <span class="mark">{{ primer.watermark }}</span>
      <h1>{{ page.title or primer.title }}</h1>
      <span class="sub">{{ page.subtitle or primer.subtitle or primer.topic }}</span>
    </div>
    <div class="badge">
      <b>{{ primer.author }}</b>
      {{ primer.watermark }}
      <br><span class="pg">{{ loop.index }}/{{ total }}</span>
    </div>
  </header>
  <main>
  {% for b in page.blocks %}
    {% if b.type == 'section' %}
    <div class="sec">
      <div class="pill-row"><span class="pill">{{ b.num or loop.index }}</span><h2>{{ b.title }}</h2></div>
      {% if b.body %}<p>{{ b.body }}</p>{% endif %}
    </div>

    {% elif b.type == 'bento' %}
    {% set cols = b.columns if b.columns in (2, 3, 4) else 3 %}
    <div class="bento c{{ cols }}">
      {% for c in b.cards %}<div class="card"><h3>{{ c.title }}</h3><p>{{ c.body }}</p></div>{% endfor %}
    </div>

    {% elif b.type == 'table' %}
    <table class="cmp">{% if b.title %}<caption>{{ b.title }}</caption>{% endif %}
      <thead><tr>{% for h in b.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>{% for r in b.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>

    {% elif b.type == 'flow' %}
    <div class="flow">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      {% set n = b.steps|length or 1 %}
      {% set bw = (186 - (n - 1) * 6) / n %}
      <svg viewBox="0 0 186 16" width="100%" xmlns="http://www.w3.org/2000/svg" role="img"
           aria-label="{{ b.title or 'flow' }}">
        {% for s in b.steps %}
        {% set x = loop.index0 * (bw + 6) %}
        {% set fs = [4.2, (bw - 2) / (0.62 * (s|length or 1))]|min %}
        <rect x="{{ '%.1f' % x }}" y="1" width="{{ '%.1f' % bw }}" height="14" rx="2"
              fill="{{ ['#d2232a','#1d4ed8','#047857','#b45309'][loop.index0 % 4] }}"/>
        <text x="{{ '%.1f' % (x + bw / 2) }}" y="10" text-anchor="middle" fill="#fff"
              font-family="Inter, Arial, sans-serif" font-size="{{ '%.1f' % fs }}"
              font-weight="700">{{ s }}</text>
        {% if not loop.last %}
        <path d="M {{ '%.1f' % (x + bw + 0.8) }} 8 l 4.4 0 m -1.8 -1.8 l 1.8 1.8 l -1.8 1.8"
              stroke="#16181d" stroke-width="1" fill="none"/>
        {% endif %}
        {% endfor %}
      </svg>
    </div>

    {% elif b.type == 'steps' %}
    <div class="steps">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      <ol>{% for s in b.items %}<li>{{ s }}</li>{% endfor %}</ol>
    </div>

    {% elif b.type == 'hierarchy' %}
    <div class="hier">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      {% set n = b.levels|length or 1 %}
      {% set rowh = 7.4 %}
      <svg viewBox="0 0 186 {{ n * (rowh + 1.6) }}" width="100%" xmlns="http://www.w3.org/2000/svg"
           role="img" aria-label="{{ b.title or 'hierarchy' }}">
        {% for lv in b.levels %}
        {% set inset = loop.index0 * (70 / n) %}
        {% set w = 186 - 2 * inset %}
        <rect x="{{ '%.1f' % inset }}" y="{{ loop.index0 * (rowh + 1.6) }}"
              width="{{ '%.1f' % w }}" height="{{ rowh }}" rx="1.6"
              fill="{{ ['#fdf2f8','#eff6ff','#ecfdf5','#fffbeb'][loop.index0 % 4] }}"
              stroke="{{ ['#d2232a','#1d4ed8','#047857','#b45309'][loop.index0 % 4] }}"
              stroke-width="0.8"/>
        <text x="{{ '%.1f' % (inset + 3) }}" y="{{ loop.index0 * (rowh + 1.6) + 5 }}"
              font-family="Inter, Arial, sans-serif" font-size="4.3" font-weight="800"
              fill="#16181d">{{ lv.label }}</text>
        {% if lv.detail %}
        <text x="{{ '%.1f' % (inset + w - 3) }}" y="{{ loop.index0 * (rowh + 1.6) + 5 }}"
              text-anchor="end" font-family="Inter, Arial, sans-serif" font-size="3.8"
              fill="#5b6372">{{ lv.detail }}</text>
        {% endif %}
        {% endfor %}
      </svg>
    </div>

    {% elif b.type == 'chart' %}
    {% set bars = b.bars or [] %}
    {% if bars %}
    {% set n = bars|length %}
    {% set maxv = (bars | map(attribute='value') | max) or 1 %}
    {% set bw = (170 - (n - 1) * 5) / n %}
    <div class="chart">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      <svg viewBox="0 0 186 34" width="100%" xmlns="http://www.w3.org/2000/svg" role="img"
           aria-label="{{ b.title or 'chart' }}">
        <line x1="10" y1="28" x2="184" y2="28" stroke="#16181d" stroke-width="0.7"/>
        <line x1="10" y1="2" x2="10" y2="28" stroke="#c9ced8" stroke-width="0.5"/>
        {% for bar in bars %}
        {% set h = (bar.value / maxv) * 20 %}
        {% set x = 12 + loop.index0 * (bw + 5) %}
        <rect x="{{ '%.1f' % x }}" y="{{ '%.1f' % (28 - h) }}" width="{{ '%.1f' % bw }}"
              height="{{ '%.1f' % h }}" rx="1"
              fill="{{ bar_colors[loop.index0 % 5] }}"/>
        <text x="{{ '%.1f' % (x + bw / 2) }}" y="{{ '%.1f' % (26.4 - h) }}" text-anchor="middle"
              font-family="Inter, Arial, sans-serif" font-size="4.2" font-weight="800"
              fill="#16181d">{{ '%g' % bar.value }}{{ b.unit or '' }}</text>
        <text x="{{ '%.1f' % (x + bw / 2) }}" y="32.6" text-anchor="middle"
              font-family="Inter, Arial, sans-serif" font-size="3.9"
              fill="#2a2f38">{{ bar.label }}</text>
        {% endfor %}
      </svg>
      {% if b.note %}<div class="note">{{ b.note }}</div>{% endif %}
    </div>
    {% endif %}

    {% elif b.type == 'code' %}
    <div class="code"><span class="bar"><span class="dot" style="background:#ff5f57"></span><span class="dot" style="background:#febc2e"></span><span class="dot" style="background:#28c840"></span> {{ b.title or b.lang or 'terminal' }}</span>{{ b.code }}</div>

    {% elif b.type == 'callout' %}
    <div class="callout {{ b.style }}"><h5>{{ b.title }}</h5><p>{{ b.body }}</p></div>

    {% elif b.type == 'kv' %}
    <div class="kv">{% if b.title %}<h4>{{ b.title }}</h4>{% endif %}
      <dl>{% for k, v in b.pairs %}<dt>{{ k }}</dt><dd>{{ v }}</dd>{% endfor %}</dl>
    </div>

    {% elif b.type == 'cloud' %}
    {{ comic_cloud(b.text) }}

    {% elif b.type == 'starburst' %}
    <div class="burst"><span>{{ b.text }}</span></div>
    {% endif %}
  {% endfor %}
  </main>
  <footer class="ft">
    {% if page.takeaway %}
    <div class="takeaway"><b>Key takeaway</b><span>{{ page.takeaway }}</span></div>
    {% endif %}
    <div class="wm">
      <span class="mark" style="margin:0;border:0">{{ primer.watermark }}</span>
      <span class="motiv">{{ primer.badge }}</span>
    </div>
  </footer>
</section>
{% endfor %}

{% if primer.citations %}
<section class="page"{% if editable %} contenteditable="true"{% endif %}>
  <header class="hd">
    <div class="t">
      <span class="mark">{{ primer.watermark }}</span>
      <h1>References</h1>
      <span class="sub">Verified sources</span>
    </div>
    <div class="badge"><b>{{ primer.author }}</b>{{ primer.watermark }}
      <br><span class="pg">{{ total }}/{{ total }}</span></div>
  </header>
  <main>
    <table class="cmp"><caption>Works cited — metadata verified via arXiv, Semantic Scholar and OpenAlex</caption>
      <thead><tr><th>#</th><th>Work</th><th>Authors</th><th>Year</th><th>ID</th></tr></thead>
      <tbody>
      {% for c in primer.citations %}
      <tr><td>{{ loop.index }}</td><td>{{ c.title }}</td>
          <td>{{ (c.authors or [])[:3]|join(', ') }}{% if (c.authors or [])|length > 3 %} et al.{% endif %}</td>
          <td>{{ c.year or '' }}</td><td>{{ c.arxiv_id or c.doi or '' }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {{ comic_cloud('Every source checked and resolvable!') }}
  </main>
  <footer class="ft">
    <div class="wm">
      <span class="mark" style="margin:0;border:0">{{ primer.watermark }}</span>
      <span class="motiv">{{ primer.badge }}</span>
    </div>
  </footer>
</section>
{% endif %}
</body>
</html>
